{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2019",
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "sourceMap": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": ["src/zod/**/*.ts"],
    "exclude": ["node_modules", "dist", "tests"]
}
